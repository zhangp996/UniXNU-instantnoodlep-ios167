# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# Applied after arch:configs/common.config, soc:configs/sm8250.config and os:configs/ios.config.
#
# UFS storage (kona-adapted ShengUfs, device-owned copy of official ShengUfs) with
# authenticated root window reads; mockfs fixture from the OS fragment.
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
# Link the [kernel] archives into the kernel (docs/guide/build-kernel): without this
# the mockfs/fixture symbols referenced by vfs_conf stay undefined at the final link.
CONFIG_XNU_BUILD_ARCHIVES=y
# CONFIG_XNU_NATIVE_ADRENO is not set
